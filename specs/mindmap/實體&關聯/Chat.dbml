// Chat（aggregate 詳細模型）：與工作日誌的對話紀錄。
// 本機 SQLite。時間為 Unix 秒。對話保存時整批刪除訊息再依序寫入。
// 規則見 ../功能/Chat/[功能]與工作日誌對話.md。

Enum chat_message_role {
  "user"
  assistant
}

Table chat_conversations {
  id text [pk, not null, note: 'UUID']
  title text [not null]
  provider text [not null, note: 'gemini、codex 或 claude']
  cli_session_id text [note: 'ChatGPT／Claude 命令列工具的對話身分，用來接續上下文']
  created_at integer [not null]
  updated_at integer [not null]
  indexes { updated_at [name: 'idx_chat_conversations_updated'] }
}

Table chat_messages {
  id text [pk, not null, note: 'UUID']
  conversation_id text [not null]
  role varchar [not null, note: 'chat_message_role']
  content text [not null]
  created_at integer [not null]
  sort_order integer [not null]
  indexes { (conversation_id, sort_order) [name: 'idx_chat_messages_conversation'] }
}

Ref: chat_messages.conversation_id > chat_conversations.id [delete: cascade]
